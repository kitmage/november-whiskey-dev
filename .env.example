HUBSPOT_LIST_ID=replace-me
HUBSPOT_PROPERTY_NAME=pci_automation
HUBSPOT_CAMPAIGN_ID=replace-me
HUBSPOT_LOOKBACK_WINDOW_HOURS=360
HUBSPOT_SIGNAL_THRESHOLD=3
HUBSPOT_PORTAL_ID=replace-me
HUBSPOT_FORM_ID=replace-me

# Microsoft Graph Auth
TENANT_ID=replace-me
CLIENT_ID=replace-me
CLIENT_SECRET=replace-me

# Graph + Scheduling
GRAPH_TIMEZONE=Pacific Standard Time
LOCAL_TIMEZONE=America/Los_Angeles
SCHEDULING_USERS=tom@example.com,rob@example.com,mike@example.com
BOOKING_WINDOW_START_HOURS=144
BOOKING_WINDOW_END_HOURS=240
BUSINESS_DAY_START_HOUR=10
BUSINESS_DAY_END_HOUR=16
LUNCH_BREAK_START_HOUR=11
LUNCH_BREAK_START_MINUTE=30
LUNCH_BREAK_END_HOUR=13
LUNCH_BREAK_END_MINUTE=0
INTERVAL_MINUTES=30
FRIDAY_AFTERNOON_START_HOUR=12
DEFAULT_DURATION_MINUTES=30

# Events / workflow
MIKE_ID=mike@example.com
DEFAULT_SUBJECT_TEMPLATE=30min Meeting - {customer_name}
DEFAULT_LOCATION=Microsoft Teams
EVENT_INTER_DELAY_SECONDS=1.0
ENABLE_TEAMS_MEETING=true
